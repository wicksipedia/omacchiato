#!/usr/bin/env bash
# theme-set <name> | light:<name>,dark:<name> — switch the whole desktop
# theme in one move.
# Swaps ~/.config/omarchy/current/theme (the omarchy convention), then
# nudges every consumer: Korren live-reloads on its own (it watches the
# omarchy dir), and the bar watches the theme and restyles in place —
# nothing here has to tell them.

set -euo pipefail
# resolve through the ~/.local/bin symlink to the real repo
REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
THEMES_DIR="$REPO_DIR/themes"
CURRENT_DIR="$HOME/.config/omarchy/current"

case "${1:-list}" in
  list)
    for t in "$THEMES_DIR"/*/; do basename "$t"; done
    exit 0
    ;;
esac

SPEC="$1"
NAME="$SPEC"
# A Ghostty-style pair, light:<name>,dark:<name>, follows the macOS
# appearance: the bar runs theme-set with the pair again when it changes.
# One name pins that theme.
if [[ "$SPEC" == *:* ]]; then
  MODE="${OMACOSY_APPEARANCE:-$(defaults read -g AppleInterfaceStyle 2>/dev/null || true)}"
  case "$MODE" in [Dd]ark) MODE=dark ;; *) MODE=light ;; esac
  NAME="$(tr ',' '\n' <<<"$SPEC" | sed -n "s/^ *$MODE: *//p" | head -1)"
fi
# a theme is a directory in themes/, so a name that is a path is refused
if [ -z "$NAME" ] || [[ "$NAME" == */* || "$NAME" == *..* ]] || [ ! -d "$THEMES_DIR/$NAME" ]; then
  echo "theme-set: unknown theme '$NAME'. Available:" >&2
  for t in "$THEMES_DIR"/*/; do basename "$t"; done >&2
  exit 1
fi

mkdir -p "$CURRENT_DIR" "$HOME/.config/omacosy"
printf 'theme = %s\n' "$SPEC" > "$HOME/.config/omacosy/theme.conf"
PREV="$(readlink "$CURRENT_DIR/theme" 2>/dev/null || true)"
ln -sfn "$THEMES_DIR/$NAME" "$CURRENT_DIR/theme"

# Korren: prefer its hand-tuned built-in theme when one matches; fall
# back to live-deriving from the omarchy palette. Korren watches its
# config file, so this repaints immediately.
KORREN_CFG="$HOME/Library/Application Support/korren/config.toml"
case "$NAME" in
  tokyo-night|catppuccin|gruvbox|solarized-dark|osaka-jade|daylight) korren_theme="$NAME" ;;
  *) korren_theme="omarchy" ;;
esac
if [ -f "$KORREN_CFG" ]; then
  sed -i '' "s/^name = \".*\"/name = \"$korren_theme\"/" "$KORREN_CFG"
fi

# Wallpaper: first image in the theme's backgrounds/ dir, on every screen.
# omacosy-helper wraps NSWorkspace (System Events wallpaper scripting
# half-broke on macOS 14+: some desktops return "missing value" and
# silently keep the old picture); osascript remains as fallback.
WALL="$(ls "$THEMES_DIR/$NAME"/backgrounds/* 2>/dev/null | head -1)"
if [ -n "$WALL" ] && [ "${PREV##*/}" != "$NAME" ]; then
  # theme-bg-next cycles through the rest; a theme switch restarts the
  # cycle at the first image, so the remembered position moves with it.
  # The same theme again, as the bar applies it at startup, keeps it.
  mkdir -p "$HOME/.local/state/omacosy"
  ln -nsf "$WALL" "$HOME/.local/state/omacosy/background"
  if [ -x "$HOME/.local/bin/omacosy-helper" ]; then
    "$HOME/.local/bin/omacosy-helper" wallpaper "$WALL" >/dev/null 2>&1 || true
  else
    # the path is an ARGUMENT, not spliced into the script text: it is a
    # filename out of a theme pack, and a theme is third-party content.
    # A wallpaper named  x" & (do shell script "...") & ".jpg  would
    # otherwise close the AppleScript string and run.
    osascript - "$WALL" >/dev/null 2>&1 <<'APPLESCRIPT' || true
on run argv
  tell application "System Events" to tell every desktop to set picture to (item 1 of argv)
end run
APPLESCRIPT
  fi
fi


# omacosy-bar re-reads the theme on its own (kqueue on
# ~/.config/omarchy/current), so the symlink swap above IS the
# notification

# Before the OmniWM edits below: OmniWM rebuilds its quake terminal from
# the Ghostty config files when settings.toml changes, so the new palette
# must be on disk by then.
# Ghostty has no theme-watching of its own, so write one from the palette
# and poke it. SIGUSR2 reloads only on Linux; on macOS it is delivered and
# ignored, which looks like success. The helper aims one Apple Event per
# Ghostty process, because omacosy opens an instance per window and
# AppleScript addresses an app by bundle, so it would reach only one.
GHOSTTY_THEME="$HOME/.config/omacosy/ghostty-theme"
if [ -f "$THEMES_DIR/$NAME/colors.toml" ]; then
  mkdir -p "$(dirname "$GHOSTTY_THEME")"
  python3 - "$THEMES_DIR/$NAME/colors.toml" "$GHOSTTY_THEME" <<'PY'
import re, sys
colors, out = sys.argv[1], sys.argv[2]
t = open(colors).read()
def val(key):
    m = re.search(r'^%s = "(#[0-9a-fA-F]{6})"' % re.escape(key), t, re.M)
    return m.group(1) if m else None
lines = ["# Written by theme-set. Edits are lost on the next theme switch."]
for i in range(16):
    v = val("color%d" % i)
    if v:
        lines.append("palette = %d=%s" % (i, v))
for key, ghostty in (("background", "background"), ("foreground", "foreground"),
                     ("cursor", "cursor-color"),
                     ("selection_background", "selection-background"),
                     ("selection_foreground", "selection-foreground")):
    v = val(key)
    if v:
        lines.append("%s = %s" % (ghostty, v))
open(out, "w").write("\n".join(lines) + "\n")
PY
  "$HOME/.local/bin/omacosy-helper" ghostty-reload >/dev/null || true
fi

# OmniWM draws the focus border. Its color lives in settings.toml as 0-1
# floats; write the theme's ACTIVE_COLOR (0xAARRGGBB) into it. OmniWM
# live-reloads, so this recolors at once.
OMNIWM_SETTINGS="$HOME/.config/omniwm/settings.toml"
if [ -f "$OMNIWM_SETTINGS" ] && [ -f "$THEMES_DIR/$NAME/borders.sh" ]; then
  ACTIVE="$(grep -o 'ACTIVE_COLOR=0x[0-9a-fA-F]*' "$THEMES_DIR/$NAME/borders.sh" | head -1 | cut -d= -f2)"
  if [ -n "$ACTIVE" ]; then
    python3 - "$OMNIWM_SETTINGS" "$ACTIVE" <<'PY'
import re, sys
path, argb = sys.argv[1], sys.argv[2]
v = int(argb, 16)
r, g, b = (v >> 16 & 0xFF) / 255, (v >> 8 & 0xFF) / 255, (v & 0xFF) / 255
t = open(path).read()
sec = re.search(r'\[borders\.color\]\n(?:[a-z]+ = [0-9.]+\n)+', t)
if sec:
    new = f"[borders.color]\nalpha = 1.0\nblue = {b}\ngreen = {g}\nred = {r}\n"
    t = t[:sec.start()] + new + t[sec.end():]
    open(path, 'w').write(t)
PY
  fi
fi

# OmniWM tints its own chrome (overview, command palette) from
# [appearance] mode, which no theme file carries. Derive it from the
# palette's background luminance so every theme, present and future, gets
# it right without a new convention to remember. A light/dark pair
# writes "automatic" instead: OmniWM can follow the system itself.
if [ -f "$OMNIWM_SETTINGS" ] && [ -f "$THEMES_DIR/$NAME/colors.toml" ]; then
  python3 - "$OMNIWM_SETTINGS" "$THEMES_DIR/$NAME/colors.toml" "$SPEC" <<'PY'
import re, sys
settings, colors, spec = sys.argv[1], sys.argv[2], sys.argv[3]
m = re.search(r'^background = "#([0-9a-fA-F]{6})"', open(colors).read(), re.M)
if m:
    r, g, b = (int(m.group(1)[i:i+2], 16) / 255 for i in (0, 2, 4))
    mode = "light" if 0.2126 * r + 0.7152 * g + 0.0722 * b > 0.5 else "dark"
    if ":" in spec:
        mode = "automatic"
    t = open(settings).read()
    t2 = re.sub(r'(\[appearance\]\nmode = )"[a-z]+"', r'\1"%s"' % mode, t, count=1)
    if t2 != t:
        open(settings, 'w').write(t2)
PY
fi


# herdr ships its own themes. Ask it whether it has one under this
# theme's name rather than keeping a copy of its list in sync: an
# unknown name comes back as a reload diagnostic, and "terminal" — which
# takes the host palette — is the fallback for everything else.
HERDR_CFG="$HOME/.config/herdr/config.toml"
# Resolved by path, not by PATH: the theme chord runs this from Karabiner,
# which passes a bare PATH with no Homebrew prefix on it, so `command -v`
# alone skipped the whole block and herdr silently kept the old theme.
HERDR_BIN=""
for candidate in "$(command -v herdr 2>/dev/null || true)" \
                 /opt/homebrew/bin/herdr /usr/local/bin/herdr; do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then HERDR_BIN="$candidate"; break; fi
done

herdr_set_theme() {
  python3 - "$HERDR_CFG" "$1" <<'@D@'
import re, sys
cfg, theme = sys.argv[1], sys.argv[2]
t = open(cfg).read()
# scope the edit to [theme]: a name key in another table is not ours
sec = re.search(r'^\[theme\]\n(?:(?!\[).*\n)*', t, re.M)
if sec:
    # subn, not a string compare: rewriting a name to the value it
    # already holds is indistinguishable from never matching at all
    body, hits = re.subn(r'^name = ".*"$', 'name = "%s"' % theme,
                         sec.group(0), count=1, flags=re.M)
    if not hits:
        body = sec.group(0).replace("[theme]\n", '[theme]\nname = "%s"\n' % theme, 1)
    t = t[:sec.start()] + body + t[sec.end():]
else:
    t = t.rstrip("\n") + '\n\n[theme]\nname = "%s"\n' % theme
open(cfg, "w").write(t)
@D@
  "$HERDR_BIN" server reload-config 2>/dev/null
}

if [ -f "$HERDR_CFG" ] && [ -n "$HERDR_BIN" ]; then
  case "$(herdr_set_theme "$NAME")" in
    *"unknown theme name"*) herdr_set_theme terminal >/dev/null ;;
  esac
fi

echo "theme: $NAME"
