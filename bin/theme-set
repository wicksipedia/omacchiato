#!/usr/bin/env bash
# theme-set <name> | light:<name>,dark:<name> — switch the whole desktop
# theme in one move.
# Swaps ~/.config/omarchy/current/theme (the omarchy convention). The bar
# watches the theme and restyles in place.

set -euo pipefail
# resolve through the ~/.local/bin symlink to the real repo
REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
THEMES_DIR="$REPO_DIR/themes"
CURRENT_DIR="$HOME/.config/omarchy/current"

case "${1:-list}" in
  list)
    for t in "$THEMES_DIR"/*/; do basename "$t"; done
    exit 0
    ;;
esac

SPEC="$1"
NAME="$SPEC"
# A Ghostty-style pair, light:<name>,dark:<name>, follows the macOS
# appearance: the bar runs theme-set with the pair again when it changes.
# One name pins that theme.
if [[ "$SPEC" == *:* ]]; then
  MODE="${OMACCHIATO_APPEARANCE:-$(defaults read -g AppleInterfaceStyle 2>/dev/null || true)}"
  case "$MODE" in [Dd]ark) MODE=dark ;; *) MODE=light ;; esac
  NAME="$(tr ',' '\n' <<<"$SPEC" | sed -n "s/^ *$MODE: *//p" | head -1)"
fi
# a theme is a directory in themes/, so a name that is a path is refused
if [ -z "$NAME" ] || [[ "$NAME" == */* || "$NAME" == *..* ]] || [ ! -d "$THEMES_DIR/$NAME" ]; then
  echo "theme-set: unknown theme '$NAME'. Available:" >&2
  for t in "$THEMES_DIR"/*/; do basename "$t"; done >&2
  exit 1
fi

mkdir -p "$CURRENT_DIR" "$HOME/.config/omacchiato"
printf 'theme = %s\n' "$SPEC" > "$HOME/.config/omacchiato/theme.conf"
PREV="$(readlink "$CURRENT_DIR/theme" 2>/dev/null || true)"
ln -sfn "$THEMES_DIR/$NAME" "$CURRENT_DIR/theme"

# Wallpaper: first image in the theme's backgrounds/ dir, on every screen.
# omacchiato-helper wraps NSWorkspace (System Events wallpaper scripting
# half-broke on macOS 14+: some desktops return "missing value" and
# silently keep the old picture); osascript remains as fallback.
WALL="$(ls "$THEMES_DIR/$NAME"/backgrounds/* 2>/dev/null | head -1)"
if [ -n "$WALL" ] && [ "${PREV##*/}" != "$NAME" ]; then
  # theme-bg-next cycles through the rest; a theme switch restarts the
  # cycle at the first image, so the remembered position moves with it.
  # The same theme again, as the bar applies it at startup, keeps it.
  mkdir -p "$HOME/.local/state/omacchiato"
  ln -nsf "$WALL" "$HOME/.local/state/omacchiato/background"
  if [ -x "$HOME/.local/bin/omacchiato-helper" ]; then
    "$HOME/.local/bin/omacchiato-helper" wallpaper "$WALL" >/dev/null 2>&1 || true
  else
    # the path is an ARGUMENT, not spliced into the script text: it is a
    # filename out of a theme pack, and a theme is third-party content.
    # A wallpaper named  x" & (do shell script "...") & ".jpg  would
    # otherwise close the AppleScript string and run.
    osascript - "$WALL" >/dev/null 2>&1 <<'APPLESCRIPT' || true
on run argv
  tell application "System Events" to tell every desktop to set picture to (item 1 of argv)
end run
APPLESCRIPT
  fi
fi


# omacchiato-bar re-reads the theme on its own (kqueue on
# ~/.config/omarchy/current), so the symlink swap above IS the
# notification

# Before the OmniWM edits below: OmniWM rebuilds its quake terminal from
# the Ghostty config files when settings.toml changes, so the new palette
# must be on disk by then.
# Ghostty has no theme-watching of its own, so write one from the palette
# and poke it. SIGUSR2 reloads only on Linux; on macOS it is delivered and
# ignored, which looks like success. The helper aims one Apple Event per
# Ghostty process, because omacchiato opens an instance per window and
# AppleScript addresses an app by bundle, so it would reach only one.
GHOSTTY_THEME="$HOME/.config/omacchiato/ghostty-theme"
if [ -f "$THEMES_DIR/$NAME/colors.toml" ]; then
  mkdir -p "$(dirname "$GHOSTTY_THEME")"
  python3 - "$THEMES_DIR/$NAME/colors.toml" "$GHOSTTY_THEME" <<'PY'
import re, sys
colors, out = sys.argv[1], sys.argv[2]
t = open(colors).read()
def val(key):
    m = re.search(r'^%s = "(#[0-9a-fA-F]{6})"' % re.escape(key), t, re.M)
    return m.group(1) if m else None
lines = ["# Written by theme-set. Edits are lost on the next theme switch."]
for i in range(16):
    v = val("color%d" % i)
    if v:
        lines.append("palette = %d=%s" % (i, v))
for key, ghostty in (("background", "background"), ("foreground", "foreground"),
                     ("cursor", "cursor-color"),
                     ("selection_background", "selection-background"),
                     ("selection_foreground", "selection-foreground")):
    v = val(key)
    if v:
        lines.append("%s = %s" % (ghostty, v))
open(out, "w").write("\n".join(lines) + "\n")
PY
  "$HOME/.local/bin/omacchiato-helper" ghostty-reload >/dev/null || true
fi

# OmniWM draws the focus border and tints its own chrome from settings.toml.
# The theme owns every [borders.*] table: color from ACTIVE_COLOR, and a
# gradient to GRADIENT_COLOR and a glow when borders.sh sets them. A
# light/dark pair also writes the dark half as darkColor, so OmniWM switches
# the border itself when macOS changes appearance. [borders] keeps the user's
# on/off and width. [appearance] mode follows the palette background's
# luminance, or is "automatic" for a pair. Both edits land in one atomic
# rename: OmniWM reloads this file on every change and must never read it
# half-written.
OMNIWM_SETTINGS="$HOME/.config/omniwm/settings.toml"
if [ -f "$OMNIWM_SETTINGS" ]; then
  python3 - "$OMNIWM_SETTINGS" "$THEMES_DIR" "$NAME" "$SPEC" <<'PY'
import os, re, sys, tempfile, tomllib
path, themes, name, spec = sys.argv[1:]
t = open(path).read()
# glow strength and gradient direction are the user's taste, not the theme's
try:
    mine = tomllib.loads(t).get("borders", {})
except tomllib.TOMLDecodeError:
    mine = {}
glow, gradient = mine.get("glow", {}), mine.get("gradient", {})
halves = {k.strip(): v.strip() for k, v in (part.split(":", 1) for part in spec.split(",") if ":" in part)}
light, dark = halves.get("light", name), halves.get("dark", name)


def border(theme):
    try:
        text = open(os.path.join(themes, theme, "borders.sh")).read()
    except OSError:
        return {}
    return {k: v.strip("'\"") for k, v in re.findall(r'^\s*(?:export\s+)?([A-Z_]+)=(\S+)', text, re.M)}


def color(table, argb):
    v = int(argb, 16)
    return "[%s]\nalpha = %s\nblue = %s\ngreen = %s\nred = %s\n" % (
        table, (v >> 24 & 0xFF) / 255, (v & 0xFF) / 255, (v >> 8 & 0xFF) / 255, (v >> 16 & 0xFF) / 255)


new, rebuilt = t, False
lit, dim = border(light), border(dark)
try:
    # a colour that is not hex leaves the border as it is
    [int(c, 16) for c in (lit.get("ACTIVE_COLOR"), dim.get("ACTIVE_COLOR"),
                          lit.get("GRADIENT_COLOR", "0"), dim.get("GRADIENT_COLOR", "0")) if c]
except ValueError:
    lit = dim = {}
if lit.get("ACTIVE_COLOR") and dim.get("ACTIVE_COLOR"):
    tables = [color("borders.color", lit["ACTIVE_COLOR"])]
    if dark != light:
        tables.append(color("borders.darkColor", dim["ACTIVE_COLOR"]))
    # glow has one on/off for both appearances, so a pair glows only when both halves do
    if lit.get("GLOW") == "1" and dim.get("GLOW") == "1":
        tables.append("[borders.glow]\nenabled = true\nopacity = %s\nradius = %s\n"
                      % (float(glow.get("opacity", 0.6)), float(glow.get("radius", 8.0))))
    if "GRADIENT_COLOR" in lit or "GRADIENT_COLOR" in dim:
        tables.append('[borders.gradient]\ndirection = "%s"\nenabled = true\n'
                      % gradient.get("direction", "topLeftToBottomRight"))
        if dark != light:
            tables.append(color("borders.gradient.dark.end", dim.get("GRADIENT_COLOR", dim["ACTIVE_COLOR"])))
            tables.append(color("borders.gradient.dark.start", dim["ACTIVE_COLOR"]))
        tables.append(color("borders.gradient.end", lit.get("GRADIENT_COLOR", lit["ACTIVE_COLOR"])))
        tables.append(color("borders.gradient.start", lit["ACTIVE_COLOR"]))
    kept, current = [], ""
    for line in new.splitlines(keepends=True):
        header = re.match(r'^\[+([^\]]+)\]+\s*$', line)
        if header:
            current = header.group(1)
        if not current.startswith("borders."):
            kept.append(line)
    at = next((i for i, line in enumerate(kept) if line.strip() == "[borders]"), None)
    if at is not None:
        end = next((i for i in range(at + 1, len(kept)) if kept[i].startswith("[")), len(kept))
        while end > at + 1 and not kept[end - 1].strip():
            end -= 1
        kept[end:end] = ["\n" + "\n".join(tables)]
        new, rebuilt = "".join(kept), True

colors = os.path.join(themes, name, "colors.toml")
if os.path.isfile(colors):
    m = re.search(r'^background = "#([0-9a-fA-F]{6})"', open(colors).read(), re.M)
    if m:
        r, g, b = (int(m.group(1)[i:i+2], 16) / 255 for i in (0, 2, 4))
        mode = "light" if 0.2126 * r + 0.7152 * g + 0.0722 * b > 0.5 else "dark"
        if ":" in spec:
            mode = "automatic"
        new = re.sub(r'(\[appearance\]\nmode = )"[a-z]+"', r'\1"%s"' % mode, new, count=1)
# rebuilding the border tables writes even when unchanged: the reload makes
# OmniWM's quake terminal pick up the Ghostty palette written above
if new != t or rebuilt:
    target = os.path.realpath(path)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(target), prefix=".settings.toml.")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(new)
        os.chmod(tmp, os.stat(target).st_mode & 0o777)
        os.replace(tmp, target)
    except BaseException:
        os.unlink(tmp)
        raise
PY
fi


# herdr ships its own themes. Ask it whether it has one under this
# theme's name rather than keeping a copy of its list in sync: an
# unknown name comes back as a reload diagnostic, and "terminal" — which
# takes the host palette — is the fallback for everything else.
HERDR_CFG="$HOME/.config/herdr/config.toml"
# Resolved by path, not by PATH: the theme chord runs this from Karabiner,
# which passes a bare PATH with no Homebrew prefix on it, so `command -v`
# alone skipped the whole block and herdr silently kept the old theme.
HERDR_BIN=""
for candidate in "$(command -v herdr 2>/dev/null || true)" \
                 /opt/homebrew/bin/herdr /usr/local/bin/herdr; do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then HERDR_BIN="$candidate"; break; fi
done

herdr_set_theme() {
  python3 - "$HERDR_CFG" "$1" <<'@D@'
import re, sys
cfg, theme = sys.argv[1], sys.argv[2]
t = open(cfg).read()
# scope the edit to [theme]: a name key in another table is not ours
sec = re.search(r'^\[theme\]\n(?:(?!\[).*\n)*', t, re.M)
if sec:
    # subn, not a string compare: rewriting a name to the value it
    # already holds is indistinguishable from never matching at all
    body, hits = re.subn(r'^name = ".*"$', 'name = "%s"' % theme,
                         sec.group(0), count=1, flags=re.M)
    if not hits:
        body = sec.group(0).replace("[theme]\n", '[theme]\nname = "%s"\n' % theme, 1)
    t = t[:sec.start()] + body + t[sec.end():]
else:
    t = t.rstrip("\n") + '\n\n[theme]\nname = "%s"\n' % theme
open(cfg, "w").write(t)
@D@
  "$HERDR_BIN" server reload-config 2>/dev/null
}

if [ -f "$HERDR_CFG" ] && [ -n "$HERDR_BIN" ]; then
  case "$(herdr_set_theme "$NAME")" in
    *"unknown theme name"*) herdr_set_theme terminal >/dev/null ;;
  esac
fi

echo "theme: $NAME"
