#!/usr/bin/env bash
# omacchiato-ws-collapse <collapse|restore> — fold the second display's
# workspaces into the primary set when a monitor unplugs, and unfold
# on replug. Called by omacchiato-bar when the monitor count changes
# (it is the one long-lived process already watching for that).
#
# collapse: with one display left, every non-empty guest workspace
#   (two-digit id) empties into the lowest EMPTY 1-9 slot — used slots
#   are never touched. Each moved window is recorded with its origin, so
#   restore is per-window: windows opened while undocked stay wherever
#   the user put them.
# restore: recorded windows go back to their origin workspaces; the map
#   is consumed.
#
# OmniWM re-routes guest WORKSPACES to the main display on unplug, but
# their windows stay on two-digit workspaces "after 9". No move-by-id
# exists, so each window is focused (verified) and then moved; the dance
# is the same one the overview's drag-reorder uses.
export PATH="/opt/homebrew/bin:$PATH"

STATE_DIR="$HOME/.local/state/omacchiato"
MAP="$STATE_DIR/collapse-map"
mkdir -p "$STATE_DIR"

OMNI="$HOME/.local/bin/omacchiato-omni"
case "${1:-}" in
  collapse)
    NDISP="$("$OMNI" query displays 2>/dev/null | /usr/bin/python3 -c 'import sys,json;print(len(json.load(sys.stdin)["result"]["payload"]["displays"]))' 2>/dev/null)" || exit 0
    [ "$NDISP" = 1 ] || exit 0
    "$OMNI" query windows id,workspace,app 2>/dev/null | /usr/bin/python3 -c '
import sys, json
wins = json.load(sys.stdin)["result"]["payload"]["windows"]
used = set(); guests = {}
for w in wins:
    ws = (w.get("workspace") or {}).get("rawName") or ""
    a = (w.get("app") or {}).get("name","")
    if not ws.isdigit() or a.startswith("omacchiato"): continue
    n = int(ws)
    if n <= 9: used.add(n)
    else: guests.setdefault(n, []).append(w["id"])
targets = [s for s in range(1, 10) if s not in used]
for gws in sorted(guests):
    if not targets: break
    t = targets.pop(0)
    for wid in guests[gws]:
        print(f"{wid}	{t}	{gws}")
' | while IFS=$'	' read -r wid target gws; do
      [ -n "$wid" ] || continue
      "$OMNI" focus-window "$wid" >/dev/null 2>&1 || continue
      sleep 0.4
      FOC="$("$OMNI" query focused-window 2>/dev/null | /usr/bin/python3 -c 'import sys,json;print((json.load(sys.stdin)["result"]["payload"].get("window") or {}).get("id",""))' 2>/dev/null)"
      [ "$FOC" = "$wid" ] || continue
      "$OMNI" command move-to-workspace "{\"workspaceNumber\":$target}" >/dev/null 2>&1 &&
        printf '%s	%s
' "$wid" "$gws" >>"$MAP"
      sleep 0.3
      echo "$(date '+%F %T') collapsed (omniwm) window -> $target (from $gws)" >>/tmp/omacchiato-ws-collapse.log
    done
    : > /tmp/omacchiato-bar-moved
    ;;
  restore)
    [ -s "$MAP" ] || exit 0
    mv "$MAP" "$MAP.run" 2>/dev/null || exit 0
    sleep 1
    while IFS=$'	' read -r wid gws; do
      [ -n "$wid" ] && [ -n "$gws" ] || continue
      "$OMNI" focus-window "$wid" >/dev/null 2>&1 || continue
      sleep 0.4
      "$OMNI" command move-to-workspace "{\"workspaceNumber\":$gws}" >/dev/null 2>&1 &&
        echo "$(date '+%F %T') restored (omniwm) window -> $gws" >>/tmp/omacchiato-ws-collapse.log
      sleep 0.3
    done <"$MAP.run"
    rm -f "$MAP.run"
    : > /tmp/omacchiato-bar-moved
    ;;
  *) echo "usage: omacchiato-ws-collapse <collapse|restore>" >&2; exit 2 ;;
esac
