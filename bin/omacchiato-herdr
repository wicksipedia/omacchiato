#!/bin/bash
# omacchiato-herdr: open or focus the Herdr desktop app. Without the app,
# run herdr in a Ghostty window.
# open passes our environment on, and herdr refuses to nest.
unset "${!HERDR_@}"
open -b dev.herdr.app 2>/dev/null && exit 0
# Karabiner gives launchd's PATH. herdr and its plugins need the PATH of
# an interactive shell, for Homebrew and version managers such as fnm.
exec "$HOME/.local/bin/omacchiato-spawn" Ghostty --command="${SHELL:-/bin/zsh} -lic 'exec herdr'"
