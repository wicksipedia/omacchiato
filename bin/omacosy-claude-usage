#!/usr/bin/env python3
"""Claude usage for a bar pill, as the JSON a bar plugin can return.

Two sources, in order.

The OAuth usage endpoint is the only place the per-model weekly windows and
the extra usage credits appear, so it is preferred. It needs the Claude CLI's
token and the network.

The statusline payload is the fallback. Claude Code hands it to whatever
statusline is configured and writes it nowhere, so omacosy-claude-statusline
saves it. It needs no credential and no network, which is what makes it the
right thing to fall back to.

This never refreshes the token and never writes to the credential store. A
third party rewriting the CLI's own credentials can race Claude Code and log
you out. On an expired or rejected token it falls back instead.
"""
import json
import os
import subprocess
import time
import urllib.error
import urllib.request
from datetime import datetime

HOME = os.path.expanduser("~")
CACHE = os.environ.get("OMACOSY_CLAUDE_USAGE_CACHE",
                       os.path.join(HOME, ".config/omacosy/claude-usage-cache.json"))
CAPTURES = [os.path.join(HOME, ".config/omacosy/claude-status.json"),
            os.path.join(HOME, ".claude/hud/.omc/state/hud-stdin-cache.json")]
KEYCHAIN_SERVICE = "Claude Code-credentials"
CREDENTIALS_FILE = os.path.join(HOME, ".claude/.credentials.json")
ENDPOINT = "https://api.anthropic.com/api/oauth/usage"
STATUS_PAGE = "https://status.claude.com"
STATUS_ENDPOINT = STATUS_PAGE + "/api/v2/summary.json"
# The page-wide rating also drops when Cowork or the console degrades, so
# the pill reads Claude Code's own component and maps its status onto the
# page's indicator scale.
COMPONENT = "Claude Code"
COMPONENT_INDICATOR = {"operational": "none", "degraded_performance": "minor",
                       "under_maintenance": "minor", "partial_outage": "major",
                       "major_outage": "critical"}

FRESH_S = 300          # re-ask the endpoint at most this often
SERVE_STALE_S = 900    # keep serving a cached body this long past FRESH_S
BACKOFF_S = 300        # after a failure, wait this long before trying again
TIMEOUT_S = 5          # the pill must not hang on a slow network

NOW = time.time()


def out(payload):
    print(json.dumps(payload))
    raise SystemExit


def seconds_until(value):
    """Accept either a unix timestamp or an ISO 8601 string."""
    if isinstance(value, (int, float)):
        return value - NOW
    try:
        return datetime.fromisoformat(value).timestamp() - NOW
    except (TypeError, ValueError):
        return None


def countdown(left):
    h, m = divmod(int(left) // 60, 60)
    return "%dh %dm" % (h, m) if h else "%dm" % m


def colour_for(pct):
    return "green" if pct < 50 else "yellow" if pct < 80 else "red"


# --- credential ------------------------------------------------------------
# Read only. The token is passed straight to the request and is never written
# to a file, a log, or this program's output.
def access_token():
    raw = None
    try:
        r = subprocess.run(["security", "find-generic-password",
                            "-s", KEYCHAIN_SERVICE, "-w"],
                           capture_output=True, text=True, timeout=TIMEOUT_S)
        if r.returncode == 0:
            raw = r.stdout
    except (OSError, subprocess.SubprocessError):
        pass
    if raw is None and os.path.exists(CREDENTIALS_FILE):
        try:
            raw = open(CREDENTIALS_FILE).read()
        except OSError:
            return None
    if raw is None:
        return None
    try:
        oauth = json.loads(raw).get("claudeAiOauth") or {}
    except ValueError:
        return None
    expires = oauth.get("expiresAt")
    # expiresAt is in milliseconds; a dead token would only earn a 401
    if isinstance(expires, (int, float)) and expires / 1000.0 <= NOW:
        return None
    return oauth.get("accessToken")


# --- cache -----------------------------------------------------------------
def read_cache():
    try:
        with open(CACHE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def write_cache(entry):
    try:
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        tmp = CACHE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(entry, f)
        os.replace(tmp, CACHE)
    except OSError:
        pass


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args):
        return None


def get_json(url, headers=None):
    req = urllib.request.Request(url, headers=headers or {})
    # urllib sends every header again to the redirect target, the token too,
    # so a request with headers follows no redirect
    open_url = urllib.request.build_opener(NoRedirect).open if headers else urllib.request.urlopen
    with open_url(req, timeout=TIMEOUT_S) as r:
        return json.load(r)


def fetch(token):
    return get_json(ENDPOINT, {
        "Authorization": "Bearer %s" % token,
        "anthropic-beta": "oauth-2025-04-20",
        "Content-Type": "application/json",
    })


def usage_body(entry):
    age = NOW - entry.get("at", 0)
    if entry.get("body") and age < FRESH_S:
        return entry["body"]
    if entry.get("failed_at") and NOW - entry["failed_at"] < BACKOFF_S:
        return entry.get("body") if age < FRESH_S + SERVE_STALE_S else None
    token = access_token()
    if token:
        try:
            body = fetch(token)
            entry.update({"at": NOW, "body": body})
            entry.pop("failed_at", None)
            write_cache(entry)
            return body
        except (urllib.error.URLError, OSError, ValueError):
            # keep the last good body so one bad request is not a blank pill
            entry["failed_at"] = NOW
            write_cache(entry)
    if entry.get("body") and age < FRESH_S + SERVE_STALE_S:
        return entry["body"]
    return None


def component_status(summary):
    for c in summary.get("components") or []:
        if c.get("name") == COMPONENT:
            s = c.get("status", "")
            return {"indicator": COMPONENT_INDICATOR.get(s, "major"),
                    "description": "%s: %s" % (COMPONENT, s.replace("_", " ").capitalize())}
    # renamed or gone: the page-wide rating is better than no signal
    return summary.get("status") or {}


def health_row(entry):
    age = NOW - entry.get("code_health_at", 0)
    status = entry.get("code_health")
    if status is None or age >= FRESH_S:
        try:
            status = component_status(get_json(STATUS_ENDPOINT))
            entry["code_health"], entry["code_health_at"] = status, NOW
            write_cache(entry)
        except (urllib.error.URLError, OSError, ValueError):
            if status is None:
                return None
    text = status.get("description")
    if not text:
        return None
    indicator = status.get("indicator")
    colour = {"none": "green", "minor": "yellow"}.get(indicator, "red")
    return {"text": text, "detail": "status", "color": colour, "url": STATUS_PAGE}


def health_icon(status):
    """Decorate the configured icon when the service is not healthy."""
    base = os.environ.get("OMACOSY_PILL_ICON", "")
    if not status:
        return None
    mark = {"none": "", "minor": "\U0001F3E5"}.get(status.get("indicator"), "\U0001FAA6")
    return base + mark if mark else None


# --- rendering -------------------------------------------------------------
def pace_colour(pct, elapsed):
    """Green at or near an even pace, yellow ahead of it, red well ahead of
    it or close to the limit. Without a clock, the usage alone decides."""
    if elapsed is None:
        return colour_for(pct)
    ahead = pct - elapsed * 100
    if pct >= 90 or ahead > 20:
        return "red"
    return "yellow" if ahead > 5 else "green"


FIVE_HOURS = 5 * 3600
WEEK = 7 * 24 * 3600


def window_rows(rows, title, pct, resets, span):
    left = seconds_until(resets) if resets is not None else None
    rows.append({"text": title, "detail": "%d%%" % round(pct)})
    slider = {"text": "", "slider": max(0.0, min(1.0, pct / 100.0))}
    # the tick marks how far through the window the clock is, so the fill
    # reads as ahead of or behind an even pace
    elapsed = 1 - left / span if left is not None and 0 < left <= span else None
    if elapsed is not None:
        slider["marker"] = elapsed
    slider["color"] = pace_colour(pct, elapsed)
    rows.append(slider)
    if left is not None and left > 0:
        rows.append({"text": "Resets in " + countdown(left), "dim": True})


def render_api(body):
    five = body.get("five_hour") or {}
    pct = five.get("utilization")
    if pct is None:
        return None
    left = seconds_until(five.get("resets_at"))
    rows = [{"text": "Claude usage", "hero": True}, {"separator": True}]
    window_rows(rows, "Session, 5-hour", pct, five.get("resets_at"), FIVE_HOURS)

    week = body.get("seven_day") or {}
    if week.get("utilization") is not None:
        rows.append({"separator": True})
        window_rows(rows, "All models, weekly", week["utilization"], week.get("resets_at"), WEEK)

    # per-model weekly windows: the server names them, so a model added later
    # appears without a change here
    for limit in body.get("limits") or []:
        scope = (limit.get("scope") or {}).get("model") or {}
        name = scope.get("display_name")
        if limit.get("kind") != "weekly_scoped" or not name:
            continue
        rows.append({"separator": True})
        window_rows(rows, "%s, weekly" % name, limit.get("percent") or 0, limit.get("resets_at"), WEEK)

    spend = body.get("spend") or {}
    used, cap = spend.get("used") or {}, spend.get("limit") or {}
    if used and cap:
        scale = 10 ** used.get("exponent", 2)
        rows.append({"separator": True})
        rows.append({"text": "Extra usage", "detail": "%d%%" % round(spend.get("percent") or 0)})
        rows.append({"text": "%.2f of %.2f %s" % (used.get("amount_minor", 0) / scale,
                                                  cap.get("amount_minor", 0) / scale,
                                                  cap.get("currency", "")), "dim": True})

    label = "%d%%" % round(pct)
    if left is not None and left > 0:
        label += " · " + countdown(left)
    return {"label": label, "color": colour_for(pct), "rows": rows}


def capture_body():
    newest, stamp = None, -1
    for path in CAPTURES:
        try:
            m = os.path.getmtime(path)
        except OSError:
            continue
        if m > stamp:
            newest, stamp = path, m
    if newest is None:
        return None
    try:
        return (json.load(open(newest)).get("rate_limits") or {})
    except (OSError, ValueError):
        return None


def render_capture(limits):
    def window(key):
        w = limits.get(key) or {}
        pct, resets = w.get("used_percentage"), w.get("resets_at")
        left = seconds_until(resets) if resets is not None else None
        # a reset time in the past describes a window that no longer exists
        if pct is None or left is None or left <= 0:
            return None, None
        return pct, resets

    five_pct, five_reset = window("five_hour")
    week_pct, week_reset = window("seven_day")
    if five_pct is None and week_pct is None:
        return None

    rows = [{"text": "Claude usage", "hero": True}, {"separator": True}]
    if five_pct is not None:
        window_rows(rows, "Session, 5-hour", five_pct, five_reset, FIVE_HOURS)
        label, colour = "%d%% · %s" % (five_pct, countdown(seconds_until(five_reset))), colour_for(five_pct)
    else:
        label, colour = "--", "muted"
        rows += [{"text": "Session, 5-hour", "detail": "--"},
                 {"text": "Window ended since the last session", "dim": True}]
    if week_pct is not None:
        rows.append({"separator": True})
        window_rows(rows, "All models, weekly", week_pct, week_reset, WEEK)
    return {"label": label, "color": colour, "rows": rows}


entry = read_cache() or {}
health = health_row(entry)
icon = health_icon(entry.get("code_health"))


def with_health(payload):
    if health:
        payload["rows"] = payload["rows"][:1] + [health, {"separator": True}] + payload["rows"][2:]
    if icon:
        payload["icon"] = icon
    return payload


body = usage_body(entry)
if body:
    rendered = render_api(body)
    if rendered:
        out(with_health(rendered))

limits = capture_body()
if limits:
    rendered = render_capture(limits)
    if rendered:
        out(with_health(rendered))

out(with_health({"label": "--", "color": "muted", "rows": [
    {"text": "Claude usage", "hero": True},
    {"separator": True},
    {"text": "No current window", "dim": True},
    {"text": "Open a Claude Code session to refresh", "dim": True}]})
    if health else {"label": ""})
