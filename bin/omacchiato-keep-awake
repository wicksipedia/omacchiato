#!/usr/bin/env python3
"""The keep-awake pill, and the command that turns keep awake on and off.

`omacchiato-keep-awake on | off | toggle | for <minutes>` writes the state
file, and the bar holds the Mac awake while it reads on. With no argument,
the script prints the pill: a dimmed cup while off, the accent cup while
on or while another process holds the Mac awake.
"""

import json
import os
import re
import subprocess
import sys
import time

AWAKE_ICON = "\U000f0176"
# Keep in sync with helper/bar/KeepAwake.swift.
STATE = os.path.expanduser("~/.local/state/omacchiato/keep-awake")


# Background daemons hold an idle assertion as a matter of course: powerd
# while a display is on, coreaudiod while anything plays, sharingd for
# Handoff. They live in the system's own directories, which separates them
# from a deliberate choice without keeping a list of their names.
SYSTEM_PREFIXES = ("/System/", "/usr/libexec/", "/usr/sbin/")

ASSERTION = re.compile(
    # pmset prints an assertion id in brackets between the owner and the age
    r"^\s*pid (\d+)\(([^)]+)\):\s*(?:\[[^\]]*\]\s*)?(\S+)\s+"
    r"PreventUserIdleSystemSleep")


# Claude Code holds a short assertion while it works. It is not a setting
# you chose, and it lapses on its own, so it is noise in a pill about what
# you left switched on.
AGENT_PARENTS = {"claude"}


def process(pid):
    """(executable, parent pid) for one process.

    Asked per holder rather than from a full listing: there are a handful
    of assertions and some hundreds of processes.
    """
    try:
        out = subprocess.run(["/bin/ps", "-o", "comm=,ppid=", "-p", pid],
                             capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return "", ""
    parts = out.stdout.split()
    return (parts[0], parts[-1]) if len(parts) >= 2 else ("", "")


def holders():
    """Name whatever is deliberately keeping the Mac awake.

    Read the assertions rather than any app's saved setting: the assertion
    is what actually holds the Mac up, so this still reads empty after the
    app holding it quits with the setting left on.
    """
    try:
        out = subprocess.run(["/usr/bin/pmset", "-g", "assertions"],
                             capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return []
    found = []
    for line in out.stdout.splitlines():
        m = ASSERTION.match(line)
        if not m or any(name == m.group(2) for name, _, _ in found):
            continue
        pid = int(m.group(1))
        executable, parent = process(m.group(1))
        if executable.startswith(SYSTEM_PREFIXES):
            continue
        if process(parent)[0].rsplit("/", 1)[-1] in AGENT_PARENTS:
            continue
        found.append((m.group(2), pid, m.group(3)))
    return found


def duration(age):
    """pmset prints the age as [days:]hours:minutes:seconds, which reads as
    a time of day. Say how long it has been held instead."""
    try:
        parts = [int(p) for p in age.split(":")]
    except ValueError:
        return age
    while len(parts) < 4:
        parts.insert(0, 0)
    days, hours, minutes, _ = parts[-4:]
    hours += days * 24
    if hours:
        return f"{hours}h {minutes}m"
    return f"{minutes}m" if minutes else "<1m"


def panel_holder(name, pid, age):
    """One holder in the panel object that the bar's keep-awake panel reads.
    Keep in sync with KeepAwakeReport(json:) in helper/ui/Sources/KeepAwakePanel."""
    return {"name": name, "pid": pid, "duration": duration(age)}


def read_state(text, now):
    """(on, end time) from the state file: "on", "off", or an end time."""
    text = text.strip()
    if text == "on":
        return True, None
    try:
        until = float(text)
    except ValueError:
        return False, None
    return (True, until) if until > now else (False, None)


def next_state(args, on, now):
    """The state file text for a command. Raises ValueError for a bad one."""
    if args == ["on"]:
        return "on"
    if args == ["off"]:
        return "off"
    if args == ["toggle"]:
        return "off" if on else "on"
    if len(args) == 2 and args[0] == "for":
        minutes = int(args[1])
        if minutes > 0:
            return str(int(now + minutes * 60))
    raise ValueError("usage: omacchiato-keep-awake [on | off | toggle | for <minutes>]")


def time_left(until, now):
    minutes = max(1, round((until - now) / 60))
    return f"{minutes // 60}h {minutes % 60}m" if minutes >= 60 else f"{minutes}m"


def render(on, until, awake, now, script):
    rows = [{"text": "Keeping Awake" if on or awake else "Sleep Allowed", "hero": True}]
    rows += [{"text": name, "detail": duration(age)} for name, _, age in awake]
    panel = {"kind": "keep-awake", "on": on, "until": until,
             "holders": [panel_holder(*h) for h in awake]}
    return {"label": time_left(until, now) if on and until else "", "icon": AWAKE_ICON,
            "color": "accent" if on or awake else "muted", "right_click": script + " toggle",
            "rows": rows, "panel": panel}


def load_state(now):
    try:
        with open(STATE) as f:
            return read_state(f.read(), now)
    except OSError:
        return False, None


def main():
    now = time.time()
    on, until = load_state(now)
    if len(sys.argv) > 1:
        try:
            text = next_state(sys.argv[1:], on, now)
        except ValueError as e:
            sys.exit(str(e))
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        with open(STATE + ".tmp", "w") as f:
            f.write(text + "\n")
        os.replace(STATE + ".tmp", STATE)
        return
    print(json.dumps(render(on, until, holders(), now, os.path.abspath(sys.argv[0])), ensure_ascii=False))


if __name__ == "__main__":
    main()
