#!/usr/bin/env bash
# omacchiato-karabiner-keys <install|remove>: the Super chords that run a
# program. Defi owns every window key, on Ctrl+Opt.
#
# Super = Caps Lock = command+control+option, so the chords arrive as
# ordinary modifier combos. Each run replaces the rules that an earlier
# run added, and removes the rules of the OmniWM era.
set -euo pipefail

KARABINER="$HOME/.config/karabiner/karabiner.json"
APPS="$HOME/.config/omacchiato/apps.conf"   # resolved by install.sh
MARK="omacchiato-keys"                       # rule-description prefix, removal key

[ -f "$KARABINER" ] || { echo "no karabiner.json" >&2; exit 1; }

TERMINAL=Ghostty BROWSER=Safari MUSIC=Spotify MESSENGER=Slack
[ -f "$APPS" ] && . "$APPS" 2>/dev/null

export KARABINER MARK TERMINAL BROWSER MUSIC MESSENGER
python3 - "$1" <<'PY'
import json, os, sys

path = os.environ["KARABINER"]
mark = os.environ["MARK"]
action = sys.argv[1]

def rule(desc, key, mods, cmd=None, to_key=None, to_mods=None):
    to = [{"shell_command": cmd}] if cmd else [{"key_code": to_key, "modifiers": to_mods or []}]
    return {
        "description": f"{mark}: {desc}",
        "manipulators": [{
            "type": "basic",
            "from": {"key_code": key, "modifiers": {"mandatory": mods}},
            "to": to,
        }],
    }

SUPER = ["command", "control", "option"]
SHIFT = SUPER + ["shift"]
home = os.environ["HOME"]
apps = {k: os.environ[k] for k in ("TERMINAL", "BROWSER", "MUSIC", "MESSENGER")}

def close_window_rule():
    r = rule("close window", "w", SUPER, to_key="w", to_mods=["command"])
    m = r["manipulators"][0]
    r["manipulators"].insert(0, {**m,
        "to": [{"key_code": "w", "modifiers": ["command", "shift"]}],
        "conditions": [{"type": "frontmost_application_if", "bundle_identifiers": ["^com\\.mitchellh\\.ghostty$"]}]})
    return r

rules = [
    rule("terminal", "return_or_enter", SUPER, cmd=f"{home}/.local/bin/omacchiato-spawn '{apps['TERMINAL']}'"),
    rule("browser", "return_or_enter", SHIFT, cmd=f"{home}/.local/bin/omacchiato-spawn '{apps['BROWSER']}'"),
    rule("herdr", "a", SUPER, cmd=f"{home}/.local/bin/omacchiato-herdr"),
    rule("files", "f", SHIFT, cmd="open -a Finder"),
    rule("music", "m", SHIFT, cmd=f"open -a '{apps['MUSIC']}'"),
    rule("messenger", "g", SHIFT, cmd=f"open -a '{apps['MESSENGER']}'"),
    # first letters where they were free: t cycles themes, so y is video
    rule("email", "e", SHIFT, cmd="open -a 'Microsoft Outlook'"),
    rule("chat", "c", SHIFT, cmd="open -a 'Microsoft Teams'"),
    rule("video", "y", SHIFT, cmd=f"open -a '{home}/Applications/YouTube.app'"),
    rule("next theme", "t", SHIFT, cmd=f"{home}/.local/bin/theme-next"),
    rule("next wallpaper", "b", SHIFT, cmd=f"{home}/.local/bin/theme-bg-next"),
    rule("lock", "l", SHIFT, cmd=f"{home}/.local/bin/omacchiato-helper lock"),
    rule("mute microphone", "m", SUPER, cmd=f"{home}/.local/bin/omacchiato-helper mic toggle >/dev/null 2>&1"),
    rule("keep awake", "escape", SUPER, cmd=f"{home}/.local/bin/omacchiato-keep-awake toggle"),
    rule("cheatsheet", "k", SUPER, cmd="/usr/bin/touch /tmp/omacchiato-bar-cheatsheet"),
    # In Ghostty, herdr takes Cmd+W to close a tab, so send Ghostty's
    # own close_window key.
    close_window_rule(),
]

with open(path) as f:
    cfg = json.load(f)

changed = False
for profile in cfg.get("profiles", []):
    if not profile.get("selected", False) and len(cfg["profiles"]) > 1:
        continue
    cm = profile.setdefault("complex_modifications", {})
    existing = cm.setdefault("rules", [])
    owned = (mark, "omacchiato-omniwm:", "omacosy-omniwm:")
    kept = [r for r in existing if not r.get("description", "").startswith(owned)]
    if action == "install":
        cm["rules"] = kept + rules
        changed = True
    else:
        if len(kept) != len(existing):
            changed = True
        cm["rules"] = kept

if changed:
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cfg, f, indent=4)
    os.replace(tmp, path)
print(f"{action}: {'applied' if changed else 'no change'}")
PY
