#!/usr/bin/env bash
# omacchiato-toggle [on|off|toggle] — park the whole tiling setup without
# uninstalling. `off`: OmniWM quits (it has no enable toggle), and the
# trackpad-gesture daemon and the bar stop. `on` restores all of it.
# No args = flip.
#
# Untouched either way: Karabiner's CapsLock=Super remap (harmless
# while OmniWM is off) and the native menu bar's auto-hide default
# (the native menu bar is there once the bar is down).
set -euo pipefail

STATE="$HOME/.config/omacchiato/disabled"
UID_N="$(id -u)"
AGENTS=(com.omacchiato.bar com.omacchiato.gesture)

mode="${1:-toggle}"
if [ "$mode" = toggle ]; then
  if [ -e "$STATE" ]; then mode=on; else mode=off; fi
fi

case "$mode" in
  off)
    osascript -e 'quit app "OmniWM"' 2>/dev/null || true
    pkill -f OmniWM.app 2>/dev/null || true
    for a in "${AGENTS[@]}"; do
      launchctl bootout "gui/$UID_N/$a" 2>/dev/null || true
    done
    mkdir -p "$(dirname "$STATE")" && : >"$STATE"
    echo "omacchiato: OFF — vanilla macOS. Restore with: omacchiato-toggle on"
    ;;
  on)
    for a in "${AGENTS[@]}"; do
      launchctl bootstrap "gui/$UID_N" "$HOME/Library/LaunchAgents/$a.plist" 2>/dev/null || true
    done
    open -a OmniWM 2>/dev/null || true
    rm -f "$STATE"
    echo "omacchiato: ON — tiling restored"
    ;;
  *)
    echo "usage: omacchiato-toggle [on|off|toggle]" >&2
    exit 2
    ;;
esac
