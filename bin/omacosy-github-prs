#!/usr/bin/env python3
"""Your open GitHub pull requests, as the JSON a bar plugin can return.

Arguments are extra GitHub search qualifiers. For example, give
`-repo:owner/name` to leave out a repository of automated PRs.

A PR has an update when it has an unread GitHub notification. GitHub marks
the notification read when you open the PR, so this script keeps no read
state of its own. A merged or closed PR stays in the list for a week, but
only while its notification is unread. A PR you unsubscribe from on GitHub
leaves the list.
"""
import json
import os
import subprocess
import sys
import time
from datetime import datetime, timedelta, timezone

HOME = os.path.expanduser("~")
CACHE = os.path.join(HOME, ".config/omacosy/github-prs-cache.json")
CLOSED_DAYS = 7
TITLE_MAX = 60
TIMEOUT_S = 30

# ponytail: one page of each search. Paginate if 100 open PRs is ever too few.
QUERY = """
query($open: String!, $closed: String!) {
  open: search(query: $open, type: ISSUE, first: 100) { nodes { ...pr } }
  closed: search(query: $closed, type: ISSUE, first: 50) { nodes { ...pr } }
}
fragment pr on PullRequest {
  number title url state isDraft mergeable reviewDecision viewerSubscription
  repository { nameWithOwner }
  reviews { totalCount }
  latestOpinionatedReviews(first: 20) { nodes { state } }
  commits(last: 1) { nodes { commit { statusCheckRollup { state } } } }
}
"""
# the url is null when the repository is gone, and split on null ends the page
UNREAD_PRS = ('.[] | select(.subject.type == "PullRequest" and .subject.url != null)'
              ' | "\\(.repository.full_name)#\\(.subject.url | split("/") | last)"')
CI_ICON = {"SUCCESS": "✅", "PENDING": "⏳", "EXPECTED": "⏳", "FAILURE": "❌", "ERROR": "❌"}
FAILED = ("FAILURE", "ERROR")


def out(payload):
    print(json.dumps(payload))
    raise SystemExit


def key(pr):
    return "%s#%d" % (pr["repository"]["nameWithOwner"], pr["number"])


def ci_state(pr):
    commits = pr["commits"]["nodes"]
    rollup = commits[0]["commit"]["statusCheckRollup"] if commits else None
    return (rollup or {}).get("state")


def icon(pr):
    if pr["state"] == "MERGED":
        return "🟣"
    if pr["state"] == "CLOSED":
        return "⚫"
    return CI_ICON.get(ci_state(pr), "⚪")


def status(pr):
    if pr["state"] == "MERGED":
        return "Merged."
    if pr["state"] == "CLOSED":
        return "Closed without merging."
    parts = []
    if pr["isDraft"]:
        parts.append("Draft.")
    if pr["mergeable"] == "CONFLICTING":
        parts.append("Has merge conflicts.")
    ci = ci_state(pr)
    if ci in FAILED:
        parts.append("CI failed.")
    elif ci in ("PENDING", "EXPECTED"):
        parts.append("CI is running.")
    # reviewDecision is null in a repository with no required reviews
    states = {r["state"] for r in pr["latestOpinionatedReviews"]["nodes"]}
    decision = pr["reviewDecision"] or next(
        (s for s in ("CHANGES_REQUESTED", "APPROVED") if s in states), None)
    if decision == "APPROVED":
        parts.append("Approved.")
    elif decision == "CHANGES_REQUESTED":
        parts.append("Changes requested.")
    elif not pr["isDraft"]:
        parts.append("Waiting for a first review." if pr["reviews"]["totalCount"] == 0
                     else "Waiting for review.")
    return " ".join(parts)


def render(open_prs, closed_prs, unread):
    open_prs = [pr for pr in open_prs if pr.get("viewerSubscription") not in ("UNSUBSCRIBED", "IGNORED")]
    shown = open_prs + [pr for pr in closed_prs if key(pr) in unread]
    groups = {}
    for pr in shown:
        groups.setdefault(pr["repository"]["nameWithOwner"], []).append(pr)
    rows = []
    for repo, prs in sorted(groups.items(), key=lambda g: (-len(g[1]), g[0].lower())):
        if rows:
            rows.append({"separator": True})
        rows.append({"text": repo, "detail": str(len(prs)), "hero": True})
        for pr in sorted(prs, key=lambda p: -p["number"]):
            title = pr["title"]
            if len(title) > TITLE_MAX:
                title = title[:TITLE_MAX - 1].rstrip() + "…"
            row = {"text": "%s #%d %s" % (icon(pr), pr["number"], title), "url": pr["url"]}
            if key(pr) in unread:
                row.update(detail="new", color="accent")
            rows.append(row)
            rows.append({"text": "    " + status(pr), "dim": True, "url": pr["url"]})
    if not rows:
        rows.append({"text": "No open pull requests", "dim": True})
    rows += [{"separator": True},
             {"text": "All pull requests on GitHub", "dim": True, "url": "https://github.com/pulls"}]
    updated = any(key(pr) in unread for pr in shown)
    payload = {"label": str(len(open_prs)) + (" !" if updated else ""), "rows": rows}
    if any(ci_state(pr) in FAILED for pr in open_prs):
        payload["color"] = "red"
    elif updated:
        payload["color"] = "accent"
    return payload


def gh(*args):
    return subprocess.Popen(["gh", *args], stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, text=True)


def result(proc):
    try:
        stdout, stderr = proc.communicate(timeout=TIMEOUT_S)
    except subprocess.TimeoutExpired:
        proc.kill()
        raise RuntimeError("GitHub did not answer")
    if proc.returncode:
        raise RuntimeError((stderr.strip().splitlines() or ["gh failed"])[0])
    return stdout


def fetch(extra):
    since = (datetime.now(timezone.utc) - timedelta(days=CLOSED_DAYS)).date().isoformat()
    base = "is:pr author:@me archived:false " + extra
    # ponytail: pages through every unread notification, about 0.6 s per 50.
    # Send If-Modified-Since if the inbox grows past a few thousand.
    notes = gh("api", "notifications?per_page=50", "--paginate", "--jq", UNREAD_PRS)
    search = gh("api", "graphql", "-f", "query=" + QUERY,
                "-f", "open=is:open " + base, "-f", "closed=is:closed closed:>=%s %s" % (since, base))
    try:
        unread = set(result(notes).split())
        data = json.loads(result(search))["data"]
    finally:
        for proc in (notes, search):
            if proc.poll() is None:
                proc.kill()
                proc.wait()
    return ([n for n in data["open"]["nodes"] if n],
            [n for n in data["closed"]["nodes"] if n], unread)


def fallback(reason):
    """Keep the last list on screen when GitHub is out of reach."""
    try:
        with open(CACHE) as f:
            cached = json.load(f)
        payload = cached["payload"]
        at = time.strftime("%H:%M", time.localtime(cached["at"]))
        payload["rows"] = [{"text": "Not updated since %s" % at, "dim": True},
                           {"text": reason[:60], "dim": True},
                           {"separator": True}] + payload["rows"]
        out(payload)
    except (OSError, ValueError, KeyError, TypeError):
        out({"label": "--", "color": "muted",
             "rows": [{"text": "GitHub pull requests", "hero": True}, {"text": reason[:60], "dim": True}]})


def self_test():
    def pr(n, ci="SUCCESS", state="OPEN", reviews=0, decision=None):
        return {"number": n, "title": "t" * 80, "url": "https://github.com/a/b/pull/%d" % n,
                "state": state, "isDraft": False, "mergeable": "MERGEABLE",
                "reviewDecision": decision, "repository": {"nameWithOwner": "a/b"},
                "reviews": {"totalCount": reviews}, "latestOpinionatedReviews": {"nodes": []},
                "commits": {"nodes": [{"commit": {"statusCheckRollup": {"state": ci}}}]}}
    p = render([pr(1), pr(2, ci="FAILURE", reviews=1, decision="APPROVED")],
               [pr(3, state="MERGED"), pr(4, state="CLOSED")], {"a/b#2", "a/b#3"})
    assert p["label"] == "2 !" and p["color"] == "red", p
    texts = [r.get("text", "") for r in p["rows"]]
    assert texts[0] == "a/b" and p["rows"][0]["detail"] == "3", texts
    assert not any("#4 " in t for t in texts), "a read closed PR is hidden"
    assert texts[1].startswith("🟣 #3 ") and texts[2].strip() == "Merged.", texts
    assert texts[3].startswith("❌ #2 ") and len(texts[3]) == len("❌ #2 ") + TITLE_MAX, texts
    assert texts[4].strip() == "CI failed. Approved.", texts
    assert texts[6].strip() == "Waiting for a first review.", texts
    assert render([pr(1)], [], set())["label"] == "1"
    muted = dict(pr(5), viewerSubscription="UNSUBSCRIBED")
    assert render([pr(1), muted], [], {"a/b#5"})["label"] == "1", "an unsubscribed PR is hidden"
    print("ok")


if sys.argv[1:] == ["--self-test"]:
    self_test()
    raise SystemExit
try:
    payload = render(*fetch(" ".join(sys.argv[1:])))
except (OSError, subprocess.SubprocessError, RuntimeError, ValueError, KeyError, TypeError) as e:
    fallback(str(e) or "Could not read GitHub")
try:
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    with open(CACHE + ".tmp", "w") as f:
        json.dump({"at": time.time(), "payload": payload}, f)
    os.replace(CACHE + ".tmp", CACHE)
except OSError:
    pass
out(payload)
