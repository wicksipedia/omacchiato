#!/usr/bin/env python3
"""Print a bar pill when a newer omacchiato release is out.

The pill is hidden while the clone is up to date. Its panel lists the
release it would move to and the new commits, with a button that runs
omacchiato-update in a terminal.
"""

import json
import re
import shlex
import subprocess
from pathlib import Path

UPDATE_ICON = "\U000f06b0"
SHOWN = 10
RELEASE = re.compile(r"^v\d{4}\.\d{2}\.\d{2}(\.\d+)?$")
# %h subject %cr, split on a byte that never appears in a commit subject.
LOG_FORMAT = "%h\x1f%s\x1f%cr"

# ~/.local/bin holds a link to this file, so resolve it to find the clone
REPO = Path(__file__).resolve().parent.parent
# The terminal starts with a bare PATH, so name the script by its path.
# Wait for Return, or the window closes before you can read the result.
UPDATE = "/bin/sh -c " + shlex.quote(
    shlex.quote(str(REPO / "bin" / "omacchiato-update"))
    + "; echo; printf 'Press Return to close. '; read _")


def git(*args, timeout=10):
    """stdout of one git command in the clone, or None if it fails."""
    try:
        out = subprocess.run(["git", "-C", str(REPO), *args],
                             capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return None
    return out.stdout if out.returncode == 0 else None


def parse_log(text):
    """[{hash, subject, age}], newest first, from one LOG_FORMAT run."""
    if not text:
        return []
    commits = []
    for line in text.splitlines():
        parts = line.split("\x1f")
        if len(parts) == 3:
            commits.append({"hash": parts[0], "subject": parts[1], "age": parts[2]})
    return commits


def git_log(target):
    """The commits HEAD does not have yet, up to target, newest first."""
    return parse_log(git("log", "--no-merges", "--format=" + LOG_FORMAT, "HEAD.." + target))


def panel_updates(commits, target):
    """The "panel" object for the bar's SwiftUI panel. Keep in sync with
    UpdatesReport.init(json:) in helper/ui/Sources/UpdatesPanel."""
    return {"kind": "updates", "target": target, "update": UPDATE,
            "commits": commits[:SHOWN], "more": max(0, len(commits) - SHOWN)}


def pill(commits, target=None):
    """The pill JSON for the commits that the clone does not have yet."""
    if not commits:
        return {"icon": "", "label": ""}
    subjects = [c["subject"] for c in commits]
    rows = [{"text": "Omacchiato Update", "hero": True}]
    rows += [{"text": s, "dim": True} for s in subjects[:SHOWN]]
    if len(subjects) > SHOWN:
        rows.append({"text": "And %d more" % (len(subjects) - SHOWN), "dim": True})
    rows += [{"separator": True},
             {"text": "Update Now", "icon": UPDATE_ICON, "terminal": UPDATE}]
    return {"icon": UPDATE_ICON, "label": str(len(commits)), "color": "yellow", "rows": rows,
            "panel": panel_updates(commits, target)}


def newest_release(tags):
    """The first release tag in git's newest-first list, or None."""
    return next((t for t in tags.split() if RELEASE.match(t)), None)


def main():
    upstream = git("rev-parse", "--abbrev-ref", "@{upstream}")
    commits, target = [], None
    if upstream:
        # With no arguments, fetch uses the remote that the branch tracks.
        # If the fetch fails, the last fetched state stays.
        git("fetch", "--quiet", "--tags", timeout=30)
        # target is the newest release, or the branch tip while the branch
        # has no release yet
        tags = git("tag", "--list", "v*", "--merged", "@{upstream}", "--sort=-v:refname") or ""
        target = newest_release(tags)
        commits = git_log(target or "@{upstream}")
    print(json.dumps(pill(commits, target)))


if __name__ == "__main__":
    main()
