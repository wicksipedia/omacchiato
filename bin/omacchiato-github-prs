#!/usr/bin/env python3
"""Your open GitHub pull requests, as the JSON a bar plugin can return.

Arguments are extra GitHub search qualifiers. For example, give
`-repo:owner/name` to leave out a repository of automated PRs.

A PR has an update when it has an unread GitHub notification. A merged or
closed PR stays in the list for a week, but only while its notification is
unread. A PR you unsubscribe from on GitHub leaves the list.

`--mark-read <owner/repo#number> <updatedAt> [<thread id>]` hides one PR
until GitHub updates it again, and marks its notification read. The panel
runs it. Then the script drops the cache, so the next run reads GitHub again.
"""
import json
import os
import shlex
import subprocess
import sys
import time
from datetime import datetime, timedelta, timezone

HOME = os.path.expanduser("~")
CACHE = os.path.join(HOME, ".config/omacchiato/github-prs-cache.json")
READ = os.path.join(HOME, ".config/omacchiato/github-prs-read.json")   # {"owner/repo#1": updatedAt}
# The bar runs this every two minutes. GitHub changes slower, so one answer serves five.
FRESH_S = 300
REFRESH_FLOOR_S = 10   # a click on the panel's "Updated" stamp reads sooner, but not more often than this
CLOSED_DAYS = 7
TITLE_MAX = 80
TIMEOUT_S = 30

# ponytail: one page of each search. Paginate if 100 open PRs is ever too few.
QUERY = """
query($open: String!, $closed: String!) {
  viewer { login }
  open: search(query: $open, type: ISSUE, first: 100) { nodes { ...pr } }
  closed: search(query: $closed, type: ISSUE, first: 50) { nodes { ...pr } }
}
fragment pr on PullRequest {
  number title url state isDraft mergeable reviewDecision viewerSubscription
  baseRefName headRefName additions deletions updatedAt
  repository { nameWithOwner }
  reviews { totalCount }
  latestOpinionatedReviews(first: 20) { nodes { state } }
  commits(last: 1) { nodes { commit { statusCheckRollup { state contexts(first: 0) {
    checkRunCountsByState { state count } statusContextCountsByState { state count } } } } } }
  reviewThreads(first: 30) { nodes { isResolved comments(first: 1) { nodes { author { login } } } } }
}
"""
# the url is null when the repository is gone, and split on null ends the page
UNREAD_PRS = ('.[] | select(.subject.type == "PullRequest" and .subject.url != null)'
              ' | "\\(.repository.full_name)#\\(.subject.url | split("/") | last) \\(.id)"')
FAILED = ("FAILURE", "ERROR")
RUNNING = ("PENDING", "EXPECTED")
# check run and status context states, as the panel counts them
COUNTED = {"SUCCESS": "passed", "NEUTRAL": "passed", "SKIPPED": "passed",
           "FAILURE": "failed", "ERROR": "failed", "TIMED_OUT": "failed", "CANCELLED": "failed",
           "ACTION_REQUIRED": "failed", "STARTUP_FAILURE": "failed",
           "PENDING": "running", "EXPECTED": "running", "IN_PROGRESS": "running", "QUEUED": "running",
           "WAITING": "running", "REQUESTED": "running"}


def out(payload):
    print(json.dumps(payload))
    raise SystemExit


def key(pr):
    return "%s#%d" % (pr["repository"]["nameWithOwner"], pr["number"])


def ci_state(pr):
    commits = pr["commits"]["nodes"]
    rollup = commits[0]["commit"]["statusCheckRollup"] if commits else None
    return (rollup or {}).get("state")


def decision(pr):
    # reviewDecision is null in a repository with no required reviews
    states = {r["state"] for r in pr["latestOpinionatedReviews"]["nodes"]}
    return pr["reviewDecision"] or next(
        (s for s in ("CHANGES_REQUESTED", "APPROVED") if s in states), None)


def open_threads(pr, me):
    """Unresolved review threads that someone other than you started."""
    count = 0
    for thread in (pr.get("reviewThreads") or {}).get("nodes") or []:
        first = ((thread.get("comments") or {}).get("nodes") or [{}])[0]
        if not thread.get("isResolved") and (first.get("author") or {}).get("login") != me:
            count += 1
    return count


def icon(pr, me):
    """One mark per PR, for what it needs next, as a glyph and a colour.

    Nerd Font glyphs, not emoji: a colour emoji in a monospaced run sits
    off the grid and carries its own hue, which fights the theme."""
    if pr["state"] == "MERGED":
        return "\U000F0419", "accent"      # git merge
    if pr["state"] == "CLOSED":
        return "\uf467", "muted"           # x
    if pr["isDraft"]:
        return "\uf448", "muted"           # pencil
    ci = ci_state(pr)
    if ci in FAILED or pr["mergeable"] == "CONFLICTING":
        return "\uf421", "red"             # warning
    if ci in RUNNING:
        return "\U000F0996", "yellow"      # progress clock
    if decision(pr) == "CHANGES_REQUESTED" or open_threads(pr, me):
        return "\uf41f", "yellow"          # comment
    if decision(pr) == "APPROVED":
        return "\U000F05E0", "green"       # check in a circle
    return "\uf43a", "muted"               # clock


def status(pr, me):
    if pr["state"] == "MERGED":
        return "Merged."
    if pr["state"] == "CLOSED":
        return "Closed without merging."
    parts = []
    if pr["isDraft"]:
        parts.append("Draft.")
    if pr["mergeable"] == "CONFLICTING":
        parts.append("Has merge conflicts.")
    ci = ci_state(pr)
    if ci in FAILED:
        parts.append("CI failed.")
    elif ci in RUNNING:
        parts.append("CI is running.")
    threads = open_threads(pr, me)
    if threads:
        parts.append("%d review thread%s to resolve." % (threads, "" if threads == 1 else "s"))
    if decision(pr) == "CHANGES_REQUESTED":
        parts.append("Changes requested.")
    return " ".join(parts)


def check_counts(pr):
    commits = pr["commits"]["nodes"]
    rollup = (commits[0]["commit"]["statusCheckRollup"] if commits else None) or {}
    contexts = rollup.get("contexts") or {}
    counts = {}
    for entry in (contexts.get("checkRunCountsByState") or []) + (contexts.get("statusContextCountsByState") or []):
        name = COUNTED.get(entry["state"])
        if name and entry["count"]:
            counts[name] = counts.get(name, 0) + entry["count"]
    return counts


def panel_pr(pr, depth, me, unread):
    """One PR for the bar's SwiftUI panel. Keep in sync with
    PRReport(json:) in helper/ui/Sources/PRPanel."""
    ci = ci_state(pr)
    return {"repo": pr["repository"]["nameWithOwner"], "number": pr["number"], "title": pr["title"],
            "url": pr["url"], "state": pr["state"].lower(), "draft": pr["isDraft"],
            "checks": "failed" if ci in FAILED else "running" if ci in RUNNING else "passed" if ci else None,
            "check_counts": check_counts(pr), "conflicts": pr["mergeable"] == "CONFLICTING",
            "review": {"APPROVED": "approved", "CHANGES_REQUESTED": "changes"}.get(decision(pr)),
            "threads": open_threads(pr, me), "unread": key(pr) in unread, "depth": depth,
            "mark_read": " ".join(shlex.quote(a) for a in [os.path.abspath(sys.argv[0]), "--mark-read", key(pr),
                                                           pr.get("updatedAt") or ""] + ([unread[key(pr)]] if key(pr) in unread else [])),
            "additions": pr.get("additions") or 0, "deletions": pr.get("deletions") or 0,
            "updated": pr.get("updatedAt")}


def stack_order(prs):
    """Each PR before the PRs based on its branch, so a stack reads base first.
    Returns (pr, depth) pairs; depth is how many PRs it sits on."""
    heads = {pr["headRefName"]: pr["number"] for pr in prs if pr.get("headRefName")}
    children, roots = {}, []
    for pr in prs:
        base = heads.get(pr["baseRefName"]) if pr.get("baseRefName") else None
        if base is not None and base != pr["number"]:
            children.setdefault(base, []).append(pr)
        else:
            roots.append(pr)
    ordered, seen = [], set()

    def walk(pr, depth):
        if pr["number"] in seen:
            return
        seen.add(pr["number"])
        ordered.append((pr, depth))
        for child in sorted(children.get(pr["number"], []), key=lambda c: -c["number"]):
            walk(child, depth + 1)

    for pr in sorted(roots, key=lambda p: -p["number"]):
        walk(pr, 0)
    # two PRs based on each other leave no root, and every PR must still show
    for pr in sorted(prs, key=lambda p: -p["number"]):
        walk(pr, 0)
    return ordered


def render(open_prs, closed_prs, unread, me="", read=None):
    read = read or {}

    def hidden(pr):
        # a PR marked read comes back when GitHub updates it again
        return key(pr) in read and read[key(pr)] == pr.get("updatedAt")

    open_prs = [pr for pr in open_prs if pr.get("viewerSubscription") not in ("UNSUBSCRIBED", "IGNORED")
                and not hidden(pr)]
    shown = open_prs + [pr for pr in closed_prs if key(pr) in unread and not hidden(pr)]
    groups = {}
    for pr in shown:
        groups.setdefault(pr["repository"]["nameWithOwner"], []).append(pr)
    rows, panel = [], []
    for repo, prs in sorted(groups.items(), key=lambda g: (-len(g[1]), g[0].lower())):
        if rows:
            rows.append({"separator": True})
        rows.append({"text": repo, "detail": str(len(prs)), "hero": True})
        for pr, depth in stack_order(prs):
            panel.append(panel_pr(pr, depth, me, unread))
            title = pr["title"]
            if len(title) > TITLE_MAX:
                title = title[:TITLE_MAX - 1].rstrip() + "…"
            lead = "  " * depth + ("↳ " if depth else "")
            glyph, tint = icon(pr, me)
            row = {"text": "%s#%d %s" % (lead, pr["number"], title), "url": pr["url"],
                   "icon": glyph, "icon_color": tint}
            if key(pr) in unread:
                row.update(detail="new", color="accent")
            rows.append(row)
            note = status(pr, me)
            if note:
                rows.append({"text": "    " + "  " * depth + note, "dim": True, "url": pr["url"]})
    if not rows:
        rows.append({"text": "No open pull requests", "dim": True})
    rows += [{"separator": True},
             {"text": "All pull requests on GitHub", "dim": True, "url": "https://github.com/pulls"}]
    updated = any(key(pr) in unread for pr in shown)
    payload = {"label": str(len(open_prs)) + (" !" if updated else ""), "rows": rows,
               "panel": {"kind": "github-prs", "prs": panel, "updated": time.time()}}
    if any(ci_state(pr) in FAILED for pr in open_prs):
        payload["color"] = "red"
    elif updated:
        payload["color"] = "accent"
    return payload


def gh(*args):
    return subprocess.Popen(["gh", *args], stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, text=True)


def result(proc):
    try:
        stdout, stderr = proc.communicate(timeout=TIMEOUT_S)
    except subprocess.TimeoutExpired:
        proc.kill()
        raise RuntimeError("GitHub did not answer")
    if proc.returncode:
        raise RuntimeError((stderr.strip().splitlines() or ["gh failed"])[0])
    return stdout


def fetch(extra):
    since = (datetime.now(timezone.utc) - timedelta(days=CLOSED_DAYS)).date().isoformat()
    base = "is:pr author:@me archived:false " + extra
    # ponytail: pages through every unread notification, about 0.6 s per 50.
    # Send If-Modified-Since if the inbox grows past a few thousand.
    notes = gh("api", "notifications?per_page=50", "--paginate", "--jq", UNREAD_PRS)
    search = gh("api", "graphql", "-f", "query=" + QUERY,
                "-f", "open=is:open " + base, "-f", "closed=is:closed closed:>=%s %s" % (since, base))
    try:
        unread = dict(line.split() for line in result(notes).splitlines() if line.strip())
        data = json.loads(result(search))["data"]
    finally:
        for proc in (notes, search):
            if proc.poll() is None:
                proc.kill()
                proc.wait()
    return ([n for n in data["open"]["nodes"] if n],
            [n for n in data["closed"]["nodes"] if n], unread, data["viewer"]["login"])


def fallback(reason):
    """Keep the last list on screen when GitHub is out of reach."""
    try:
        with open(CACHE) as f:
            cached = json.load(f)
        payload = cached["payload"]
        at = time.strftime("%H:%M", time.localtime(cached["at"]))
        payload["rows"] = [{"text": "Not updated since %s" % at, "dim": True},
                           {"text": reason[:60], "dim": True},
                           {"separator": True}] + payload["rows"]
        if "panel" in payload:
            payload["panel"]["problem"] = reason[:120]
        out(payload)
    except (OSError, ValueError, KeyError, TypeError):
        out({"label": "--", "color": "muted",
             "rows": [{"text": "GitHub pull requests", "hero": True}, {"text": reason[:60], "dim": True}]})


def fresh(key, now, max_age=FRESH_S):
    """The last payload for these search qualifiers, if it is younger than max_age."""
    try:
        with open(CACHE) as f:
            cached = json.load(f)
        if cached.get("key") == key and 0 <= now - cached["at"] < max_age:
            return cached["payload"]
    except (OSError, ValueError, KeyError, TypeError):
        pass
    return None


def load_read():
    try:
        with open(READ) as f:
            read = json.load(f)
        return read if isinstance(read, dict) else {}
    except (OSError, ValueError):
        return {}


def save_read(read):
    os.makedirs(os.path.dirname(READ), exist_ok=True)
    with open(READ + ".tmp", "w") as f:
        json.dump(read, f)
    os.replace(READ + ".tmp", READ)


def mark_read(pr_key, updated, thread=None):
    read = load_read()
    read[pr_key] = updated
    save_read(read)
    try:
        if thread:
            result(gh("api", "-X", "PATCH", "notifications/threads/%d" % int(thread)))
    finally:
        try:
            os.remove(CACHE)
        except OSError:
            pass


def main():
    if sys.argv[1:2] == ["--mark-read"]:
        mark_read(*sys.argv[2:5])
        return
    search = " ".join(sys.argv[1:])
    # the bar sets OMACCHIATO_REFRESH=1 when the user asks for a refresh
    refresh = os.environ.get("OMACCHIATO_REFRESH") == "1"
    cached = fresh(search, time.time(), REFRESH_FLOOR_S if refresh else FRESH_S)
    if cached is not None:
        out(cached)
        return
    try:
        open_prs, closed_prs, unread, me = fetch(search)
        read = load_read()
        payload = render(open_prs, closed_prs, unread, me, read)
        # forget the PRs that left the search, so the file stays small
        listed = {key(pr) for pr in open_prs + closed_prs}
        if read.keys() - listed:
            try:
                save_read({pr: at for pr, at in read.items() if pr in listed})
            except OSError:
                pass
    except (OSError, subprocess.SubprocessError, RuntimeError, ValueError, KeyError, TypeError) as e:
        fallback(str(e) or "Could not read GitHub")
        return
    try:
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        with open(CACHE + ".tmp", "w") as f:
            json.dump({"at": time.time(), "key": search, "payload": payload}, f)
        os.replace(CACHE + ".tmp", CACHE)
    except OSError:
        pass
    out(payload)


if __name__ == "__main__":
    main()
