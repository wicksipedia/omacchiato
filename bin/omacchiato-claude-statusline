#!/usr/bin/env bash
# Save the Claude Code statusline payload, then run the real statusline.
#
# Claude Code hands its statusline command a JSON payload on stdin, and that
# payload is the only place the rate limit windows appear. Claude Code does not
# write them to disk. Put this script in front of the statusline you already
# use, and omacchiato-claude-usage gets the numbers without a plugin in between.
#
# Configure it in ~/.claude/settings.json as the statusline command, followed by
# the command it must run, for example:
#   "command": "$HOME/.local/share/omacchiato/bin/omacchiato-claude-statusline node $HOME/.claude/hud/omc-hud.mjs"
# With no command after it, this script only saves the payload.
set -uo pipefail

OUT="${OMACCHIATO_CLAUDE_STATUS:-$HOME/.config/omacchiato/claude-status.json}"

payload=$(cat)

# Write through a temporary file so a reader never sees a half-written payload.
if mkdir -p "$(dirname "$OUT")" 2>/dev/null; then
    if tmp=$(mktemp "$OUT.XXXXXX" 2>/dev/null); then
        if printf '%s' "$payload" >"$tmp" 2>/dev/null; then
            mv -f "$tmp" "$OUT" 2>/dev/null || rm -f "$tmp"
        else
            rm -f "$tmp"
        fi
    fi
fi

# A statusline that fails to save must still draw, so ignore every error above.
[ "$#" -gt 0 ] || exit 0
printf '%s' "$payload" | "$@"
