#!/usr/bin/env bash
# omacchiato-update [--check] — pull this repo and re-run install.sh.
#
# install.sh is idempotent and rebuilds only the binaries whose sources
# changed, so updating is a pull plus a re-run. This finds the clone
# (the bin/ scripts are symlinked into it), refuses to touch a tree
# that has your own edits in it, shows what changed, and hands over to
# install.sh.
#
# --check only reports whether an update exists and exits: nothing here
# contacts the network unless you run it, which is why there is no
# background update nag.
set -euo pipefail
export PATH="/opt/homebrew/bin:$PATH"

say() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
die() { printf '\033[1;31m==>\033[0m %s\n' "$*" >&2; exit 1; }

# This script lives in the clone, but is reached through a symlink in
# ~/.local/bin — resolve the link to find the repo it belongs to.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *) SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
REPO="$(cd "$(dirname "$SELF")/.." && pwd)"
[ -f "$REPO/install.sh" ] || die "could not find the omacchiato clone (looked in $REPO)"
git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1 || die "$REPO is not a git clone; update by hand"

# install.sh checks app versions itself; this covers the exits that skip it
requirements() {
  say "app versions"
  "$REPO/bin/omacchiato-requirements" || say "WARNING: an app above is older than omacchiato needs"
}

BRANCH="$(git -C "$REPO" rev-parse --abbrev-ref HEAD)"
say "clone: $REPO (on $BRANCH)"

# Your own edits win: a pull that would stash or merge them is not
# something a one-word command should decide for you.
if [ -n "$(git -C "$REPO" status --porcelain)" ]; then
  git -C "$REPO" status --short | sed 's/^/    /'
  die "the clone has local changes — commit, stash or discard them first"
fi

say "checking for updates"
# the branch's own upstream, so a clone of a fork pulls from the fork
UPSTREAM="$(git -C "$REPO" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null)" ||
  die "$BRANCH tracks no remote branch; set one with: git branch -u <remote>/<branch>"
git -C "$REPO" fetch --quiet "${UPSTREAM%%/*}" "${UPSTREAM#*/}" || die "could not reach the remote"
LOCAL="$(git -C "$REPO" rev-parse HEAD)"
REMOTE="$(git -C "$REPO" rev-parse "$UPSTREAM")"

if [ "$LOCAL" = "$REMOTE" ]; then
  say "already up to date ($(git -C "$REPO" log -1 --format='%h %s'))"
  requirements
  exit 0
fi

# Being AHEAD is normal if you commit to your own clone, and is not an
# error: there is simply nothing to pull. Only a genuine divergence
# (both sides moved) is refused, because merging that silently is how a
# clone ends up in a state nobody can reason about.
if git -C "$REPO" merge-base --is-ancestor "$REMOTE" "$LOCAL"; then
  AHEAD="$(git -C "$REPO" rev-list --count "$REMOTE..$LOCAL")"
  say "nothing to pull — you are $AHEAD commit(s) ahead of $UPSTREAM"
  requirements
  exit 0
fi
if ! git -C "$REPO" merge-base --is-ancestor "$LOCAL" "$REMOTE"; then
  die "your branch and $UPSTREAM have both moved — resolve by hand"
fi

COUNT="$(git -C "$REPO" rev-list --count "$LOCAL..$REMOTE")"
say "$COUNT new commit(s):"
git -C "$REPO" log --no-merges --format='    %h %s' "$LOCAL..$REMOTE" | head -20
[ "$COUNT" -gt 20 ] && say "    ... and $((COUNT - 20)) more"

if [ "${1:-}" = "--check" ]; then
  say "run without --check to apply"
  requirements
  exit 0
fi

say "pulling"
git -C "$REPO" merge --ff-only "$UPSTREAM" --quiet ||
  die "fast-forward failed; resolve by hand"

# install.sh rebuilds only what changed and restarts the agents it
# owns, so it is the update step as well as the install step
say "running install.sh"
"$REPO/install.sh"
say "updated to $(git -C "$REPO" log -1 --format='%h %s')"
