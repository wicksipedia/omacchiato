# omacchiato zsh — the CLI-stack wiring. Personal config belongs in
# ~/.zshrc.local (sourced below), so this file stays generic.

[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"

export PATH="$HOME/.local/bin:$PATH"

# omacchiato repo location, derived from the installed theme-set symlink
if [ -L "$HOME/.local/bin/theme-set" ]; then
  export OMACCHIATO="$(dirname "$(dirname "$(readlink -f "$HOME/.local/bin/theme-set")")")"
fi

autoload -Uz compinit
for dump in ~/.zcompdump(N.mh+24); do
  compinit -u
done
compinit -C

# everything personal lives here; keep this file distributable
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"

# CLI stack (after .zshrc.local so frameworks there can't clobber these)
eval "$(starship init zsh)"
eval "$(zoxide init zsh)"
command -v fzf >/dev/null && source <(fzf --zsh)

alias ls='eza --group-directories-first --icons=auto'
alias ll='eza -lh --group-directories-first --icons=auto'
alias la='eza -lah --group-directories-first --icons=auto'
alias lt='eza --tree --level=2 --icons=auto'
alias cat='bat --paging=never'
alias lg='lazygit'

# ...and one more hook AFTER them. .zshrc.local runs before this stack so
# a framework there cannot clobber it, but that also means a personal
# alias there loses to the defaults above. Put the ones that must win here.
[ -f "$HOME/.zshrc.after" ] && source "$HOME/.zshrc.after"
