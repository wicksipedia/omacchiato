# omacosy — everything the setup needs, installable via `brew bundle`

# Window management
cask "omniwm"
cask "karabiner-elements"  # Caps Lock -> Super
cask "ghostty"             # default terminal + floating TUI host (btop)
cask "raycast"             # launcher on Cmd+Space, set in Raycast

# CLI stack
brew "fzf"
brew "eza"
brew "zoxide"
brew "ripgrep"
brew "bat"
brew "lazygit"
brew "btop"
brew "starship"
brew "jq"
brew "gh"                  # the GitHub pull requests pill

cask "font-jetbrains-mono-nerd-font"
