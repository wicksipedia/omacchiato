# Ghostty settings for the omacchiato look. Loaded from ~/.config/ghostty
# (symlinked by install.sh); your personal settings can live in
# ~/Library/Application Support/com.mitchellh.ghostty/config — Ghostty
# reads both.

# No titlebar, no traffic lights — the Hyprland look. Close is Super+W,
# moving is Super+Shift+arrows, so nothing the bar provided is lost.
macos-titlebar-style = hidden

# Colours come from the desktop theme: theme-set writes this file on every
# switch and signals Ghostty to reload. The "?" keeps a fresh install, where
# theme-set has not run yet, from erroring.
config-file = ?~/.config/omacchiato/ghostty-theme

# Pin the initial size of NEW windows (in cells). Ghostty otherwise
# inherits the previous window's size, and under a tiling WM that is
# usually the full screen — so every spawn played its open animation at
# full size over the whole layout before the window manager tiled it.
# Small and fixed, the pre-tile moment is a brief unobtrusive window
# instead.
window-width = 100
window-height = 30

# ...and because that pinned size is not the tile, the WM resizes every
# new window the moment it appears. Ghostty's default `after-first`
# suppresses the size badge only on creation and shows it for any resize
# AFTER that, so the tiling resize qualified — and so did every re-tile
# when a sibling window opened or closed. The result was "NNxMM" in the
# middle of the window for 750 ms, over and over. A compositor never
# trips this, because it sizes the window before mapping it; an
# Accessibility-API tiler always does.
resize-overlay = never

# Every Super+Enter opens a NEW Ghostty instance (`open -na` — one app
# per window, which is what makes each window a first-class tile).
# Without this, closing the window leaves its windowless instance
# running forever: ten stale ghostty processes after a day's work.
quit-after-last-window-closed = true

# herdr runs in every window and binds these keys itself.
keybind = super+t=unbind
keybind = super+w=unbind
keybind = super+n=unbind
keybind = super+digit_1=unbind
keybind = super+digit_2=unbind
keybind = super+digit_3=unbind
keybind = super+digit_4=unbind
keybind = super+digit_5=unbind
keybind = super+digit_6=unbind
keybind = super+digit_7=unbind
keybind = super+digit_8=unbind
keybind = super+1=unbind
keybind = super+2=unbind
keybind = super+3=unbind
keybind = super+4=unbind
keybind = super+5=unbind
keybind = super+6=unbind
keybind = super+7=unbind
keybind = super+8=unbind
keybind = super+9=unbind
# If unbound, ctrl+tab reaches herdr as a plain Tab, so send the CSI-u form.
keybind = ctrl+tab=text:\x1b[9;5u
keybind = ctrl+shift+tab=text:\x1b[9;6u
