{
  "haptic": true,
  "fingers": 3,
  "swipe_left": "$HOME/.local/bin/omacchiato-defi focus-column right >/dev/null 2>&1",
  "swipe_right": "$HOME/.local/bin/omacchiato-defi focus-column left >/dev/null 2>&1",
  "swipe_up": "$HOME/.local/bin/omacchiato-defi focus-workspace down >/dev/null 2>&1",
  "swipe_down": "$HOME/.local/bin/omacchiato-defi focus-workspace up >/dev/null 2>&1"
}
